# Kopier til .env og fyll inn.
#
# GRATISPRINSIPP: Dette skal kunne gjennomføres uten at noen i gruppen
# bruker egne penger. Velg en leverandør med reell gratis-tilgang (ingen
# kredittkort). En betalt modell er valgfritt tillegg i eksperimentdelen
# (Del B) - aldri en forutsetning. Gratisnivåer endrer seg over tid - sjekk
# gjeldende vilkår hos leverandøren.
#
# Kjente gratis-alternativer:
#   - OpenRouter (https://openrouter.ai/keys): velg en modell merket
#     ":free" i modellnavnet - se openrouter.ai/models?max_price=0
#   - Google AI Studio / Gemini (https://aistudio.google.com/apikey):
#     gratis kvote, OpenAI-kompatibelt endepunkt.
#   - Groq (https://console.groq.com/keys): gratis kvote, OpenAI-kompatibelt.
#   - OpenAI direkte (https://platform.openai.com/api-keys) er IKKE gratis -
#     bruk kun hvis gruppen bevisst velger å betale selv (f.eks. for Del B).
API_KEY=AQ.Ab8RN6L-2zInrLCx8aELZM4i3HZLr2k5VgwvYnOp_qyUbUUZdg

# Modellnavn slik leverandøren deres forventer det.
# Eksempel på GRATIS modell hos OpenRouter (anbefalt standardvalg):
MODEL_NAME=Google ai studio
# Andre eksempler:
#   openai/gpt-4o-mini   (billig, IKKE gratis - valgfritt for Del B)
#   gemini-1.5-flash     (hvis dere bruker Google AI Studio direkte)

# Base-URL for API-et. Eksempler:
#   https://openrouter.ai/api/v1                             (OpenRouter, gratis-modeller finnes)
#   https://generativelanguage.googleapis.com/v1beta/openai/ (Google AI Studio, gratis kvote)
#   https://api.groq.com/openai/v1                           (Groq, gratis kvote)
#   https://api.openai.com/v1                                (OpenAI, betalt)
API_BASE_URL=https://aistudio.google.com/app/api-keys
